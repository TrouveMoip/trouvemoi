# Exemple de configuration — remplacez les valeurs par les vôtres.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/trouvemoi

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sécurité et services externes, selon les fonctionnalités utilisées
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_PHONE=
SMSPRO_API_KEY=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SANDBOX=true
